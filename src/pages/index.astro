---
const title = "Miguel Alcázar";
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>{title}</title>
<meta name="description" content="Miguel Alcázar — Escritor" />

<link rel="icon" type="image/png" href="/images/favicon.PNG" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <main>
<div class="home-logo">
  <img
    id="logo"
    src="/images/logos/01.png"
    alt="Miguel Alcázar"
  />
</div>

<nav class="menu">
  <a href="/mgl">MGL</a>
  <a href="/txts">TXTS</a>
  <a href="/cntxt">CNTXT</a>
  <a href="/cntct">CNTCT</a>
</nav>


      <nav class="socials">
  <a
    href="https://www.instagram.com/miguelalcazarrr/"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Instagram"
  >
    <img src="/icons/instagram.svg" alt="Instagram" />
  </a>

  <a
    href="https://x.com/miguelalcazarrr"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="X"
  >
    <img src="/icons/x.svg" alt="X" />
  </a>

  <a
    href="https://bsky.app/profile/miguelalcazarrr.bsky.social"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Bluesky"
  >
    <img src="/icons/bluesky.svg" alt="Bluesky" />
  </a>

  <a
    href="https://open.spotify.com/user/mx5cl07qyu8d0la9pbozlrk38"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Spotify"
  >
    <img src="/icons/spotify.svg" alt="Spotify" />
  </a>
</nav>
    </main>

<script>
  const logo = document.getElementById("logo");

  const frames = [
    "/images/logos/01.png",
    "/images/logos/02.png",
    "/images/logos/03.png",
    "/images/logos/04.png",
    "/images/logos/05.png",
    "/images/logos/06.png",
    "/images/logos/07.png"
  ];

  // Mezcla los fotogramas aleatoriamente
  frames.sort(() => Math.random() - 0.5);

  // Añade siempre el logo final al final
  frames.push("/images/logos/08.png");

  let frame = 0;

  function nextFrame() {
    if (frame >= frames.length) return;

    logo.src = frames[frame];

    frame++;

    setTimeout(nextFrame, 300);
  }

  window.addEventListener("load", () => {
    setTimeout(nextFrame, 300);
  });
</script>
  </body>
</html>

<style>
body {
  margin: 0;
  background: #F8F8F6;
  color: #111;
  font-family: "Source Serif 4", serif;
  font-weight: 400;
}

main {
  min-height: auto;
  padding: 80px 20px 50px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

/* LOGO */

/* LOGO */

.home-logo {
  width: 680px;
  height: 185px;
  margin-bottom: 72px;
  display: flex;
  justify-content: center;
  align-items: center;
}

.home-logo img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}

/* MENU */

.menu {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18px;
  margin-bottom: 72px;
}

.menu a,
.menu a:link,
.menu a:visited {
  font-size: 2rem;
  font-weight: 400;
  color: #111;
  text-decoration: none;
  transition: color 0.2s ease;
}

.menu a:hover {
  color: #4f79b8;
}

/* EMAIL */

.email {
  margin: 0 0 60px;
  font-size: 18px;
  line-height: 1.75;
}

.email a,
.email a:link,
.email a:visited {
  color: #111;
  text-decoration: none;
  transition: color 0.2s ease;
}

.email a:hover {
  color: #4f79b8;
}

/* SOCIALS */

.socials {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 22px;
}

.socials img {
  width: 36px;
  height: 36px;
  display: block;
  opacity: 0.85;
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.socials a:hover img {
  opacity: 1;
  transform: translateY(-2px);
}

/* MOBILE */

@media (max-width: 700px) {
  main {
    padding: 40px 20px;
  }

.home-logo {
  width: 500px;
  height: 135px;
  margin-bottom: 56px;
}

.home-logo img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

  .menu a {
    font-size: 1.7rem;
  }

  .email,
  .socials {
    font-size: 16px;
  }
}
</style>