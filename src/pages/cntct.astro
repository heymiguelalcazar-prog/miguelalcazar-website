---
import Layout from "../layouts/Layout.astro";
---

<Layout title="CNTCT">

  <main>
    <section class="contact">

      <a href="mailto:heymiguelalcazar@gmail.com">
        <img src="/images/letter.gif" alt="Email" />
        <span>heymiguelalcazar@gmail.com</span>
      </a>

    </section>
  </main>

</Layout>

<style>

main {
  width: 100%;
  min-height: calc(100vh - 220px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 20px;
  box-sizing: border-box;
}

.contact {
  text-align: center;
  transform: translateY(-100px);
}

.contact a {
  font-size: 22px;
  color: #111;
  text-decoration: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 25px;
}

.contact img {
  width: 300px;
  height: auto;
  display: block;
}

.contact a:hover,
.contact a:focus,
.contact a:active {
  color: #4f7fcf;
}

@media (max-width: 700px) {

  .contact img {
    width: 250px;
  }

  .contact a {
    font-size: 18px;
  }

}

</style>