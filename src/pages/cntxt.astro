<style>
main {
  margin-left: 60px;
  padding-top: 70px;
  padding-bottom: 80px;
  width: calc(100% - 120px);
}

.content {
  display: grid;
  grid-template-columns: 280px minmax(700px, 1fr);
  column-gap: 120px;
  align-items: start;
}

.quotes {
  width: 280px;
}

.quotes p {
  font-size: 22px;
  line-height: 1.55;
  margin: 0 0 32px;
}

.quotes span {
  color: #111;
  font-size: 20px;
}

.press {
  width: 100%;
  max-width: 1000px;
  font-size: 22px;
  line-height: 1.55;
  text-align: left;
  overflow-wrap: break-word;
}

.press p {
  margin: 0;
}

.press a:link,
.press a:visited {
  color: #111;
  text-decoration: underline;
  text-underline-offset: 3px;
  transition: color 0.2s ease;
}

.press a:hover,
.press a:focus {
  color: #4f7fcf;
}

.press a:active {
  color: #4f7fcf;
}

.press i {
  font-style: normal;
  color: #ddd;
  margin: 0 12px;
}


@media (max-width: 1100px) {
  .content {
    grid-template-columns: 250px minmax(500px, 1fr);
    column-gap: 70px;
  }
}


@media (max-width: 900px) {

  main {
    margin-left: 28px;
    width: calc(100% - 56px);
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 60px;
  }

  .quotes {
    width: auto;
  }

  .press {
    font-size: 22px;
  }

}
</style>